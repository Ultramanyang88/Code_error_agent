# Copy this file to .env and fill in what you need. .env is gitignored (see
# .gitignore) -- your key never gets committed. Loaded automatically by
# main.py / api/server.py (python-dotenv) and by scripts/dev-up.sh; nothing
# else needs to change.
#
# Everything below is optional -- the agent runs with zero configuration
# (rule-based fallback planner, in-memory sessions, host-execution tools).
# Fill in only the pieces you want to turn on.

# ── LLM ──────────────────────────────────────────────────────────────────
# Required for LLM mode (--llm on the CLI, or the web UI's default "OpenAI"
# provider). Never sent to the browser -- read server-side only (llm.py).
OPENAI_API_KEY=

# ── Postgres (optional persistence -- see README "Postgres + Redis") ──────
# docker compose up -d postgres   # schema auto-applied from db/schema.sql
DATABASE_URL=postgresql://agent:agent_dev_password@localhost:5432/agent

# ── Redis (optional: session TTL, SSE relay, RQ broker) ────────────────────
# docker compose up -d redis
REDIS_URL=redis://localhost:6379/0

# ── Task queue (optional -- needs REDIS_URL above; see README "Task queue") ─
AGENT_QUEUE_ENABLED=0

# ── Docker sandbox (optional; see README "Sandbox") ─────────────────────────
AGENT_SANDBOX_ENABLED=0

# ── MCP servers (optional; see mcp_servers.json.example) ───────────────────
# MCP_SERVERS_CONFIG=/path/to/mcp_servers.json

# ── Structured logging (optional; see core/logging_setup.py) ───────────────
# AGENT_LOG_DIR=logs
# AGENT_LOG_LEVEL=INFO
